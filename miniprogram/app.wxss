/**app.wxss**/
page {
  background-color: #0f0f23;
  color: #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* 卡片容器 */
.card {
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #e94560 0%, #c23152 100%);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.8;
}

/* 数值标签 */
.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #e94560;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #666;
}