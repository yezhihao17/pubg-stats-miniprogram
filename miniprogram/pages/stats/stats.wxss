/* pages/stats/stats.wxss */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 玩家头部 */
.player-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 0 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #2a2a4a;
}

.player-avatar-lg {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e94560, #533483);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #e94560;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.player-name-lg {
  font-size: 36rpx;
  font-weight: 700;
  color: #e0e0e0;
}

.player-platform {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.player-extra {
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
}

.player-meta {
  flex: 1;
}

/* 赛季下拉选择器 */
.season-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.picker-label {
  font-size: 26rpx;
  color: #aaa;
  font-weight: 600;
  flex-shrink: 0;
}

.picker-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #1a1a2e;
  border: 2rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.picker-text {
  flex: 1;
  font-size: 26rpx;
  color: #e0e0e0;
}

.picker-badge {
  background: #ffd700;
  color: #1a1a2e;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.picker-arrow {
  font-size: 20rpx;
  color: #666;
}

/* 生涯概要（4项卡片，设计稿要求） */
.career-summary {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.cs-item {
  flex: 1;
  background: #16213e;
  border-radius: 10rpx;
  padding: 10rpx 4rpx;
  text-align: center;
  border: 2rpx solid #2a2a4a;
}

.cs-item.highlight {
  border-color: #e94560;
}

.cs-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #e94560;
  margin-bottom: 4rpx;
}

.cs-label {
  display: block;
  font-size: 20rpx;
  color: #888;
}

/* 概要行 */
.summary-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.summary-item {
  flex: 1;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border: 2rpx solid #e94560;
  border-radius: 12rpx;
  padding: 10rpx 4rpx;
  text-align: center;
}

.summary-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #e94560;
  margin-bottom: 4rpx;
}

.summary-label {
  display: block;
  font-size: 20rpx;
  color: #888;
}

/* 分区标签 */
.section-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
  font-weight: 600;
}

/* 双层 Tab */
.type-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 12rpx;
  background: #16213e;
  border-radius: 12rpx;
  border: 2rpx solid #2a2a4a;
  overflow: hidden;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 10rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #888;
  border-right: 2rpx solid #2a2a4a;
}

.type-tab:last-child {
  border-right: none;
}

.type-tab.active {
  background: #e94560;
  color: #fff;
}

.mode-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 16rpx;
  background: #16213e;
  border-radius: 12rpx;
  border: 2rpx solid #2a2a4a;
  overflow: hidden;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #888;
  border-right: 2rpx solid #2a2a4a;
}

.mode-tab:last-child {
  border-right: none;
}

.mode-tab.active {
  background: #e94560;
  color: #fff;
}

/* 详情卡片 */
.detail-card {
  background: #1a1a2e;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 2rpx solid #2a2a4a;
  margin-bottom: 16rpx;
}

.detail-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e94560;
  margin-bottom: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #2a2a4a;
}

.data-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.dr-item {
  width: 33.33%;
  text-align: center;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.dr-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #e0e0e0;
  margin-bottom: 4rpx;
}

.dr-label {
  display: block;
  font-size: 22rpx;
  color: #666;
}

/* 空数据 */
.empty-data {
  text-align: center;
  padding: 60rpx 0;
  color: #666;
  font-size: 28rpx;
}

/* 加载 & 错误 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  color: #666;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #2a2a4a;
  border-top-color: #e94560;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-toast {
  background: #3d1e1e;
  color: #ff6b6b;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

/* 按钮 */
.action-bar {
  padding: 16rpx 0 40rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  text-align: center;
  padding: 0;
  box-sizing: border-box;
}