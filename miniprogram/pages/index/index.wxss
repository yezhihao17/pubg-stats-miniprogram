/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.logo-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #e94560, #533483);
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #e94560;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
  text-align: center;
}

/* 搜索卡片 */
.search-card {
  margin: 0 0 24rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 16rpx;
  font-weight: 600;
}

/* 平台选择器 */
.platform-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.platform-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #16213e;
  border: 2rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #ccc;
  transition: all 0.2s;
}

.platform-option.active {
  background: #e94560;
  border-color: #e94560;
  color: #fff;
}

.platform-icon {
  font-size: 28rpx;
}

/* 输入框 */
.input-group {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}

.search-input {
  flex: 1;
  background: #16213e;
  border: 2rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #e0e0e0;
  height: 90rpx;
  box-sizing: border-box;
}

.search-btn {
  flex-shrink: 0;
  height: 90rpx;
  line-height: 90rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #e94560 0%, #c23152 100%);
  color: #fff;
  text-align: center;
}

/* 搜索结果 */
.result-section {
  margin-top: 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #aaa;
  margin: 0 16rpx 16rpx;
  display: block;
}

.player-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 0 16rpx;
}

.player-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e94560, #533483);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.player-detail {
  display: flex;
  flex-direction: column;
}

.player-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e0e0e0;
}

.player-id {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.arrow {
  font-size: 40rpx;
  color: #555;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #555;
}

/* 错误提示 */
.error-toast {
  background: #3d1e1e;
  color: #ff6b6b;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-top: 16rpx;
  font-size: 26rpx;
}

/* 历史搜索记录 */
.history-section {
  margin-top: 16rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 16rpx 16rpx;
}

.history-header .section-title {
  margin: 0;
}

.clear-btn {
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 16rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-tag {
  background: #16213e;
  border: 2rpx solid #2a2a4a;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #aaa;
}