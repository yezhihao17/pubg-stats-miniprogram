/* ============================================ */
/* 单场比赛详情 — 完全按设计稿 v6.2             */
/* ============================================ */

.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #1a1a2e;
  box-sizing: border-box;
}

/* ========== 页面头部 ========== */
.md-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 4rpx solid #e94560;
}

.md-back {
  font-size: 36rpx;
  color: #888;
  padding: 8rpx 12rpx;
  flex-shrink: 0;
}

.md-header-info {
  flex: 1;
}

.md-header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e0e0e0;
  display: block;
}

.md-header-sub {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
  display: block;
}

/* ========== 比赛信息条 ========== */
.md-info-bar {
  display: flex;
  gap: 0;
  margin-bottom: 20rpx;
  padding: 16rpx 0;
  background: #16213e;
  border-radius: 12rpx;
  border: 2rpx solid #2a2a4a;
}

.md-info-item {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid #2a2a4a;
}

.md-info-item:last-child {
  border-right: none;
}

.md-info-label {
  font-size: 20rpx;
  color: #666;
  display: block;
}

.md-info-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #e0e0e0;
  margin-top: 4rpx;
  display: block;
}

/* ========== 队伍卡片 ========== */
.team-card {
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #2a2a4a;
  background: #1a1a2e;
}

/* 自己的队伍 - 红色边框 */
.team-card.my-team {
  border-color: #e94560;
  background: linear-gradient(135deg, #1a1a2e, #2a1a2e);
  position: relative;
  margin-top: 24rpx;
}

.team-card.my-team::before {
  content: "👤 我的队伍";
  position: absolute;
  top: -18rpx;
  left: 20rpx;
  background: #e94560;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  z-index: 1;
}

/* ========== 队伍头部 ========== */
.team-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #2a2a4a;
}

.team-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.team-rank.gold { background: #ffd700; color: #1a1a2e; }
.team-rank.silver { background: #c0c0c0; color: #1a1a2e; }
.team-rank.bronze { background: #cd7f32; color: #fff; }
.team-rank.default { background: #2a2a4a; color: #888; }
.team-rank.win { background: #4caf50; color: #fff; }

.team-kills {
  font-size: 22rpx;
  color: #888;
  margin-left: auto;
}

.team-total-kills {
  font-size: 26rpx;
  font-weight: 700;
  color: #e94560;
}

/* ========== 表头 ========== */
.member-header {
  display: flex;
  align-items: center;
  padding: 0 0 8rpx 0;
  margin-bottom: 4rpx;
}

.mh-name {
  flex: 1;
  font-size: 20rpx;
  color: #555;
}

.mh-stat {
  width: 110rpx;
  text-align: center;
  font-size: 20rpx;
  color: #555;
}

/* ========== 队员行 ========== */
.member-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(42, 42, 74, 0.3);
}

.member-row:last-child {
  border-bottom: none;
}

.member-left {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.member-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #e0e0e0;
  line-height: 1.4;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-name.me {
  color: #e94560;
  font-weight: 700;
}

/* 玩家标签 */
.player-badge {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 700;
  padding: 1rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 6rpx;
  vertical-align: middle;
  line-height: 1.6;
}

.player-badge.mvp {
  background: rgba(233,69,96,0.2);
  color: #e94560;
  border: 2rpx solid rgba(233,69,96,0.4);
}

.player-badge.medic {
  background: rgba(76,175,80,0.15);
  color: #4caf50;
  border: 2rpx solid rgba(76,175,80,0.3);
}

.player-badge.carry {
  background: rgba(255,215,0,0.15);
  color: #ffd700;
  border: 2rpx solid rgba(255,215,0,0.3);
}

.player-badge.dropbox {
  background: rgba(120,120,120,0.15);
  color: #888;
  border: 2rpx solid rgba(120,120,120,0.3);
}

/* ========== 伤害进度条 ========== */
.damage-track {
  width: 180rpx;
  height: 6rpx;
  background: #16213e;
  border-radius: 3rpx;
  overflow: hidden;
  margin-top: 8rpx;
}

.damage-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #e94560, #ff6b6b);
  transition: width 0.3s;
}

.damage-fill.max {
  background: linear-gradient(90deg, #ffd700, #ff6b6b);
}

/* ========== 统计数据列 ========== */
.member-stats {
  display: flex;
  flex-shrink: 0;
}

.member-stat {
  width: 110rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #e0e0e0;
  line-height: 1.4;
  padding-top: 2rpx;
}

/* ========== 分区标签 ========== */
.section-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
  font-weight: 600;
  display: block;
}

/* ========== 加载 & 错误 ========== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #666;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #2a2a4a;
  border-top-color: #e94560;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-toast {
  background: #3d1e1e;
  color: #ff6b6b;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}