/* ============================================ */
/* 历史比赛列表 — 按 Designer 新设计             */
/* ============================================ */

.container {
  min-height: 100vh;
  padding: 30rpx;
  background: #1a1a2e;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 4rpx solid #e94560;
}

.page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #e0e0e0;
}

.page-count {
  font-size: 24rpx;
  color: #888;
}

/* 筛选 Tab */
.filter-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 20rpx;
  background: #16213e;
  border-radius: 12rpx;
  border: 2rpx solid #2a2a4a;
  overflow: hidden;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #888;
  border-right: 2rpx solid #2a2a4a;
}

.filter-tab:last-child {
  border-right: none;
}

.filter-tab.active {
  background: #e94560;
  color: #fff;
}

/* 比赛卡片 */
.match-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-card {
  background: #16213e;
  border-radius: 14rpx;
  border: 2rpx solid #2a2a4a;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
}

/* 左边色条 */
.match-card.won::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: #ffd700;
}

.match-card.lost::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: #e94560;
}

/* Row 1: 模式 + 标签 + 地图 */
.match-top-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.match-mode {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.match-type-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
}

.match-type-tag.ranked {
  background: rgba(233, 69, 96, 0.2);
  color: #e94560;
  border: 2rpx solid rgba(233, 69, 96, 0.3);
}

.match-type-tag.casual {
  background: rgba(76, 175, 80, 0.15);
  color: #4caf50;
  border: 2rpx solid rgba(76, 175, 80, 0.3);
}

.match-map {
  font-size: 24rpx;
  color: #888;
  margin-left: auto;
}

/* Row 2: 时间 + 时长 */
.match-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #666;
}

.dot {
  color: #444;
}

.chicken-text {
  color: #ffd700;
  font-weight: 600;
}

/* Row 3: 击杀 + 排名 + 辅助数据 */
.match-stats-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.match-kills {
  flex-shrink: 0;
  text-align: center;
  min-width: 80rpx;
}

.kills-number {
  font-size: 56rpx;
  font-weight: 800;
  color: #e94560;
  line-height: 1;
  display: block;
}

.kills-label {
  font-size: 20rpx;
  color: #666;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
  display: block;
}

.match-rank {
  flex-shrink: 0;
  text-align: center;
  min-width: 72rpx;
}

.rank-number {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  display: block;
}

.rank-number.gold { color: #ffd700; }
.rank-number.green { color: #4caf50; }
.rank-number.red { color: #e94560; }

.rank-label {
  font-size: 20rpx;
  color: #666;
  letter-spacing: 2rpx;
  margin-top: 4rpx;
  display: block;
}

.match-secondary-stats {
  display: flex;
  gap: 24rpx;
  margin-left: auto;
}

.stat-item {
  text-align: center;
  min-width: 60rpx;
}

.stat-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #ccc;
  display: block;
}

.stat-label {
  font-size: 18rpx;
  color: #555;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
  display: block;
}

/* Row 4: 徽章 */
.match-badges {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #2a2a4a;
}

.match-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.match-badge.chicken {
  background: linear-gradient(135deg, rgba(255,215,0,0.2), rgba(255,215,0,0.1));
  color: #ffd700;
  border: 2rpx solid rgba(255,215,0,0.3);
}

.match-badge.top10 {
  background: rgba(76,175,80,0.12);
  color: #4caf50;
  border: 2rpx solid rgba(76,175,80,0.25);
}

.match-badge.mvp {
  background: rgba(233,69,96,0.15);
  color: #e94560;
  border: 2rpx solid rgba(233,69,96,0.3);
}

.match-badge.medic {
  background: rgba(76,175,80,0.12);
  color: #4caf50;
  border: 2rpx solid rgba(76,175,80,0.25);
}

.match-badge.carry {
  background: rgba(255,215,0,0.12);
  color: #ffd700;
  border: 2rpx solid rgba(255,215,0,0.25);
}

.match-badge.dropbox {
  background: rgba(120,120,120,0.15);
  color: #888;
  border: 2rpx solid rgba(120,120,120,0.25);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #888;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  color: #888;
  font-size: 26rpx;
}

/* 加载 & 错误 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #666;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #2a2a4a;
  border-top-color: #e94560;
  border-radius: 50%;
  margin-bottom: 20rpx;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-toast {
  background: #3d1e1e;
  color: #ff6b6b;
  padding: 20rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}